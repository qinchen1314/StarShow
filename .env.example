# StarShow 环境变量模板（本地开发复制为 .env 并全部替换为独立随机值，严禁提交真实 .env）
# 注意：应用启动门禁会拒绝空白值与以下公开占位值！

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=starshow
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-mysql-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-local-redis-password

# RocketMQ 5.3.0
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
RMQ_PROXY_PORT_8080=8080
RMQ_PROXY_PORT_8081=8081

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848

# Ops Stack (可选)
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-grafana-password
XXL_JOB_ACCESS_TOKEN=replace-with-xxl-token

# Security（必须生成独立随机串：JWT >= 32 字节；AES-256 恰为 32 字节；Pepper 与内部密钥 >= 16 字节）
STARSHOW_JWT_SECRET=replace-with-at-least-32-bytes-random-jwt-secret
STARSHOW_AES_KEY=replace-with-exact-32-byte-key!!
STARSHOW_IDCARD_PEPPER=replace-with-random-idcard-pepper
STARSHOW_INTERNAL_GATEWAY_SECRET=replace-with-random-gateway-secret

# Show / Inventory Cache & Preheat (Phase 2)
STARSHOW_SHOW_DETAIL_L1_TTL_SECONDS=60
STARSHOW_SHOW_DETAIL_L1_MAX_SIZE=5000
STARSHOW_SHOW_DETAIL_L2_LOGICAL_TTL_SECONDS=300
STARSHOW_SHOW_DETAIL_L2_JITTER_SECONDS=300
STARSHOW_SHOW_DETAIL_MAX_STALE_SECONDS=900
STARSHOW_SHOW_NEGATIVE_CACHE_TTL_SECONDS=30
STARSHOW_SHOW_COLD_READ_TIMEOUT_MS=150
STARSHOW_SHOW_STOCK_LOCAL_TTL_MS=0
STARSHOW_SHOW_PREHEAT_BATCH_SIZE=50
STARSHOW_SHOW_TASK_RECOVERY_BATCH_SIZE=100

# Order / Seckill Engine V1~V4 & Gateway Rate Limit (Phase 3)
STARSHOW_SECKILL_STRATEGY=V4
STARSHOW_SECKILL_TOKEN_TTL_SECONDS=60
STARSHOW_SECKILL_REQUEST_TTL_SECONDS=1800
STARSHOW_SECKILL_REQUEST_LEASE_MS=15000
STARSHOW_SECKILL_DEDUCT_PROOF_TTL_SECONDS=86400
STARSHOW_SECKILL_PENDING_MIN_AGE_SECONDS=300
STARSHOW_SECKILL_ORDER_EXPIRE_MINUTES=15
STARSHOW_SECKILL_PER_TIER_CONSUMER_CONCURRENCY=1
STARSHOW_SECKILL_MQ_ENABLED=true
STARSHOW_GW_SECKILL_RL_ENABLED=true
STARSHOW_GW_SECKILL_RL_USER_LIMIT=20
STARSHOW_GW_SECKILL_RL_SHOW_LIMIT=5000
STARSHOW_GW_SECKILL_RL_WINDOW_SECONDS=1
