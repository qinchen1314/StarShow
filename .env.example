# StarShow 环境变量模板（本地开发复制为 .env 使用，严禁提交真实 .env）

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=starshow
MYSQL_USER=root
MYSQL_PASSWORD=starshow_dev_pass

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=starshow_redis_pass

# RocketMQ 5.3.0
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848

# Ops Stack (可选)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana
XXL_JOB_ACCESS_TOKEN=change_me_xxl_token

# Security (生产环境必须更换为高熵随机串)
STARSHOW_JWT_SECRET=starshow-dev-jwt-secret-key-please-change-in-production-32bytes
STARSHOW_AES_KEY=0123456789abcdef0123456789abcdef
STARSHOW_IDCARD_PEPPER=starshow-dev-idcard-hmac-pepper-change-me
